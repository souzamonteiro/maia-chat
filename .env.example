HOST=127.0.0.1
PORT=3080

MAIA_NAME=Maia
MAIA_VERSION=0.1.0
# ollama (default) or openai-compatible (llama.cpp or vLLM).
MAIA_INFERENCE_PROVIDER=ollama
MAIA_DEFAULT_MODEL=qwen2.5:3b
# Optional JSON array of canonical Ollama IDs to hide and reject.
# Example: ["qwen2.5:14b","qwen2.5-coder:14b"]
MAIA_MODEL_BLACKLIST=[]
# Optional JSON array of client tool names that Maia may pass to Ollama. Empty
# disables tool calling. Maia never executes tools; the API client owns execution.
MAIA_TOOL_ALLOWLIST=[]
# Optional JSON keyed by canonical model ID. System prompts are server-only.
# Example: {"qwen2.5-coder:7b":{"systemPrompt":"Focus on code.","generation":{"temperature":0.2,"top_p":0.95,"max_tokens":1024}}}
MAIA_MODEL_SETTINGS={}
# Set true to request an empty completion and keep the default model warm.
MAIA_WARMUP_MODEL=false
MAIA_SYSTEM_PROMPT=
MAIA_CONTEXT_WINDOW=8192
MAIA_MAX_REQUEST_BYTES=1048576
# Maximum PDF/Office document size before base64 encoding.
MAIA_MAX_DOCUMENT_BYTES=10485760
MAIA_MAX_MESSAGES=100
MAIA_MAX_OUTPUT_TOKENS=2048
MAIA_MAX_CONCURRENT_GENERATIONS=2
MAIA_MAX_CONCURRENT_GENERATIONS_PER_CLIENT=1
MAIA_MAX_QUEUED_GENERATIONS=8
MAIA_GENERATION_QUEUE_TIMEOUT_MS=30000
MAIA_RATE_LIMIT_WINDOW_MS=60000
MAIA_RATE_LIMIT_MAX_REQUESTS=20
# Required to expose GET /api/metrics to Prometheus.
MAIA_METRICS_TOKEN=
# Required to expose detailed GET /api/health/ready status to operations tooling.
MAIA_OPERATIONS_TOKEN=
# Optional private SearXNG search backend. Leave disabled until SearXNG is ready.
MAIA_SEARCH_PROVIDER=disabled
MAIA_SEARXNG_URL=
MAIA_SEARCH_TIMEOUT_MS=10000
MAIA_SEARCH_MAX_RESULTS=5
MAIA_SHUTDOWN_TIMEOUT_MS=30000

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_MS=120000
# Required only when MAIA_INFERENCE_PROVIDER=openai-compatible.
MAIA_OPENAI_COMPATIBLE_URL=
MAIA_OPENAI_COMPATIBLE_TOKEN=

# Optional. A JSON array of individually revocable hashed keys for /v1/*.
# Generate records with: node scripts/generate-api-key.js <id>
# Scopes: models, chat, embeddings. Example: [{"id":"cli","hash":"<sha256-hex>","scopes":["models","chat"],"expiresAt":"2027-01-01T00:00:00Z"}]
MAIA_API_KEYS=[]

# Comma-separated Nginx IPs/CIDRs trusted to set X-Forwarded-For. Leave empty
# when Maia Chat is reached directly; never use a trust-all value.
MAIA_TRUSTED_PROXY=

# Comma-separated list. Empty means allow the local web UI origin.
MAIA_ALLOWED_ORIGINS=
