[Unit]
Description=Maia Chat Web and API
Requires=wg-quick@wg0.service
After=network-online.target wg-quick@wg0.service ollama.service
Wants=network-online.target

[Service]
Type=simple
User=maia
Group=maia
WorkingDirectory=/srv/maia/maia-chat
EnvironmentFile=/srv/maia/maia-chat/.env
ExecStart=/usr/bin/node server/server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=45

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/maia-chat

[Install]
WantedBy=multi-user.target
